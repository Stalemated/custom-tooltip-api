{
	"schemaVersion": 1,
	"id": "customtooltips",
	"version": "${version}",
	"name": "Custom Tooltip API",
	"description": "A completely customizable, tag-based tooltip manager for developers and modpack makers.",
	"authors": [
		"Stalemated"
	],
	"contact": {
		"homepage": "https://www.curseforge.com/minecraft/mc-mods/custom-tooltip-api",
		"sources": "https://github.com/Stalemated/custom-tooltip-api",
		"issues": "https://github.com/Stalemated/custom-tooltip-api/issues"
	},
	"license": "MIT",
	"icon": "icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			"com.stalemated.customtooltips.fabric.CustomTooltipApiFabric"
		],
		"modmenu": [
			"com.stalemated.customtooltips.fabric.ModMenuIntegration"
		]
	},
	"mixins": [
		"customtooltips.mixins.json",
		"customtooltips-fabric.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.19.2",
		"minecraft": "~1.21.1",
		"java": ">=21",
		"fabric-api": "*",
        "s_lib": ">=0.0.1",
		"yet_another_config_lib_v3": ">=3.8.2"
	}
}